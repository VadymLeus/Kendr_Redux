@startuml
skinparam DefaultTextAlignment center

|Користувач|
start
:Переходить на /support/new;
:Заповнює форму тікету;
:Натискає "Відправити";

|Система (Backend / БД)|
:Створює тікет (status='open');

repeat :Тікет не закрито?;
  |Адміністратор|
  :Переглядає чергу тікетів;
  :Обирає тікет;
  :Надсилає відповідь;
  
  |Система (Backend / БД)|
  :Оновлює статус на 'answered';
  
  |Користувач|
  :Переглядає відповідь\nв особистому кабінеті;
  
  if (Проблема вирішена?) then (Так)
    :Натискає "Закрити тікет";
    |Система (Backend / БД)|
    :Оновлює статус на 'closed';
    detach
  else (Ні)
    |Система (Backend / БД)|
    :Додає уточнюючий коментар;
    :Оновлює статус на 'in_progress';
    :Повідомляє адміністратора;
    |Адміністратор|
    -> Повернення до черги;
  endif
repeat while ()

@enduml