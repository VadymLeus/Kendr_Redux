# ===== Локальна розробка: значення нижче працюють «з коробки» =====
# Для розгортання замініть секрети на власні

# --- Сервер ---
PORT=5000
NODE_ENV=development

# --- База даних (MySQL 8) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=KendrDB

# --- Безпека (лише для локальної розробки!) ---
JWT_SECRET=dev-only-secret-change-in-production
# Рівно 32 символи, інакше сервер не запуститься
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# --- Cloudflare Turnstile (тестовий ключ, завжди проходить) ---
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Вимикає перевірку Turnstile (капчу) лише при NODE_ENV, відмінному від production
TURNSTILE_DISABLED=true

# --- Адреси ---
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
# Лише для локального тестування вебхуків LiqPay через тунель
# NGROK_URL=

# --- Ліміти запитів (необов'язково, значення за замовчуванням) ---
# RATE_LIMIT_LOGIN_MINUTES=15
# RATE_LIMIT_LOGIN_MAX=5
# RATE_LIMIT_REGISTER_MINUTES=60
# RATE_LIMIT_REGISTER_MAX=5
# RATE_LIMIT_FORGOT_MINUTES=60
# RATE_LIMIT_FORGOT_MAX=3

# ===== Зовнішні сервіси (потрібні лише для відповідного функціоналу) =====

# Вхід через Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Медіатека
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Оплата LiqPay
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
# 1 — тестовий режим шлюзу (sandbox); у робочому середовищі не задавайте
LIQPAY_SANDBOX=1

# Листи
RESEND_API_KEY=

# Доставка «Нова Пошта»
NOVA_POSHTA_API_KEY=